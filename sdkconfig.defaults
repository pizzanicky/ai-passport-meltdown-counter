# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享。
# 1a9f5caf 在界面创建后打印 used_pct=49（约 22 KB）。36 KB 留出刷新余量，
# 并把约 12 KB 还给 Wi-Fi/BLE。点阵数字、柱和月历格用静态 A8 蒙版。
CONFIG_LV_MEM_SIZE_KILOBYTES=36
CONFIG_LV_TXT_ENC_UTF8=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_BLUFI_ENABLE=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
# 单连接配网。池大小取 ESP-IDF examples/bluetooth/blufi/sdkconfig.defaults.mini。
# 不采用该文件的 MTU 23、关闭 Wi-Fi 和关闭 GATT client：协商需要默认 MTU。
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=15
# DH 协商在 NimBLE host 任务里同步计算。默认 4096 栈算不完，手机就停在安全通道。
# 增加的 4 KB 用应用任务从 12288 降到 8192 抵消，避免配网后的最大空闲块被吃掉。
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# 广播加一条连接。官方 BLUFI mini 用 2 个 activity，每个约 828 字节。
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# 配网只用传统广播。关掉 BLE 5 扩展和 DTM，减小控制器占用。
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_CTRL_DTM_ENABLE=n

# BLUFI 安全协商沿用 Espressif 参考实现。
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_DHM_C=y
# 两个 SNTP 服务器:ntp.aliyun.com 与 pool.ntp.org。
CONFIG_LWIP_SNTP_MAX_SERVERS=2
